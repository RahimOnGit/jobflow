{
  "manifest_version": 3,
  "name": "JobFlow - Save Applied Job",
  "version": "2.0",
  "description": "AI-powered job saver for Arbetsförmedlingen activity reports.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save applied job"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://api.groq.com/*"
  ]
}
